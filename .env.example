# Copier ce fichier en .env puis renseigner les deux clés :  cp .env.example .env

# --- Obligatoire ---
# Token Lichess (https://lichess.org/account/oauth/token, aucun scope nécessaire)
LICHESS_API_TOKEN=
# Clé API YouTube Data v3 (Google Cloud Console > API et services > Identifiants)
API_KEY_YOUTUBE=

# --- Ne pas modifier (réseau Docker) ---
MILVUS_HOST=standalone
MILVUS_PORT=19530
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# --- Optionnel ---
# Ports exposés sur la machine
FRONTEND_PORT=4200
API_PORT=8000
# Quota YouTube (unités par jour) et durée du cache des vidéos (secondes)
YOUTUBE_DAILY_QUOTA=10000
YOUTUBE_CACHE_TTL_SECONDS=86400
